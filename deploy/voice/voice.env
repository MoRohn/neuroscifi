# NeuroSciFi Voice Cortex speech services (hybrid path, ADR-037 draft; docs/voice/COGNITIVE_VOICE_BRIDGE.md).
# Defaults for deploy/voice/run.sh and the neuroscifi-voice-{asr,tts}.service units. Override any line in
# ~/.config/neuroscifi/voice/voice.env (not in git).

# Derived images built by `run.sh build` FROM vllm/vllm-openai@sha256:48c0a41e…3009700 (Dockerfile.asr/.tts pin the
# base by digest and the added Python packages by version). run.sh refuses an image whose base layers differ.
NSF_VOICE_ASR_IMAGE=neuroscifi-voice-asr:0.7.0
NSF_VOICE_TTS_IMAGE=neuroscifi-voice-tts:0.7.0
NSF_VOICE_BASE_IMAGE=vllm/vllm-openai@sha256:48c0a41e8268faf50317ab83dc12c54fe6549b1131b38d06abe5ed15e3009700
# Loopback only (8000/9000/3000/8811/8888 are taken on the reference host).
NSF_VOICE_BIND=127.0.0.1
NSF_VOICE_ASR_PORT=18431
NSF_VOICE_TTS_PORT=18432
NSF_VOICE_ASR_CONTAINER=neuroscifi-voice-asr
NSF_VOICE_TTS_CONTAINER=neuroscifi-voice-tts
# Weights on the host, mounted read-only (copied from the Hugging Face cache; revision in each REVISION file).
# openai/whisper-large-v3-turbo (MIT) rev 41f01f3f…; hexgrad/Kokoro-82M (Apache-2.0) rev f3ff3571….
NSF_VOICE_ASR_MODEL_DIR=${HOME}/.local/share/neuroscifi/models/whisper-large-v3-turbo
NSF_VOICE_ASR_SERVED_NAME=whisper-large-v3-turbo
NSF_VOICE_TTS_MODEL_DIR=${HOME}/.local/share/neuroscifi/models/kokoro-82m
# Measured on GB10 unified memory (PERSONAPLEX_INTEGRATION.md §6.5): vLLM's default utilisation fails; 0.08 alone
# trips the memory profiler; a fixed KV cache skips it. Eager mode avoids CUDA-graph capture for a small model.
NSF_VOICE_ASR_GPU_UTIL=0.08
NSF_VOICE_ASR_KV_CACHE_BYTES=2147483648
NSF_VOICE_ASR_MAX_SEQS=4
# Kokoro device: cuda (RTF 0.013) or cpu (RTF 0.42 with 8 threads; CUDA hidden from the container).
NSF_VOICE_TTS_DEVICE=cuda
NSF_VOICE_TTS_THREADS=8
# Container ceilings. CUDA allocations count against the memory cgroup on unified memory.
NSF_VOICE_ASR_CPUS=4
NSF_VOICE_ASR_MEMORY=20g
NSF_VOICE_TTS_CPUS=8
NSF_VOICE_TTS_MEMORY=8g
NSF_VOICE_PIDS=1024
# Generated API key (shared by both services) and caches, outside git.
NSF_VOICE_DIR=${HOME}/.config/neuroscifi/voice
NSF_VOICE_CACHE_DIR=${HOME}/.cache/neuroscifi/voice
