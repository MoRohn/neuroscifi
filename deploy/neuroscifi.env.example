# NeuroSciFi service settings. Install as /etc/neuroscifi/neuroscifi.env (root:neuroscifi, mode 0640).
# systemd reads this file as KEY=VALUE lines with no shell expansion and no quotes needed.
# Every key is optional; the value shown is the default built into the unit files.
# Reference: docs/operations/ENVIRONMENT.md

# Instance database used by the console, the nightly checkpoint job and operator commands (NSF_DB).
# It must live on the encrypted volume. Checkpoints go to a "checkpoints" folder next to it.
NSF_DB=/var/lib/neuroscifi/instance.sqlite

# Pocket's own database (paired devices and 24-hour field records). It is separate from the instance.
# Keep it on the encrypted volume and exclude it from backups and cloud sync.
NSF_POCKET_DB=/var/lib/neuroscifi/pocket.sqlite

# Pocket binding. Loopback is the default and needs no TLS. Any other address requires TLS (below).
NSF_POCKET_BIND=127.0.0.1
NSF_POCKET_PORT=8765

# TLS arguments for Pocket, split on spaces, so paths must not contain spaces. Leave empty for loopback.
# LAN example: bind to the private interface address and supply a certificate the phone trusts.
#   NSF_POCKET_BIND=192.168.1.20
#   NSF_POCKET_TLS_ARGS=--cert /etc/neuroscifi/tls/fullchain.pem --key /etc/neuroscifi/tls/privkey.pem
# /etc/neuroscifi/tls is root:neuroscifi 0750; fullchain.pem and privkey.pem are root:neuroscifi 0640.
NSF_POCKET_TLS_ARGS=

# Operator console port. The console always binds loopback; reach it through an SSH tunnel.
NSF_CONSOLE_PORT=8766

# Web Cortex (off until `nsf web config --enable`). The worker and the tick timer use NSF_DB above.
# Loopback port of the open-webSearch daemon (neuroscifi-websearch.service always binds 127.0.0.1).
# If you change it, point the individual at it too: nsf web config --set 'openwebsearch_url="http://127.0.0.1:PORT"'
NSF_WEBSEARCH_PORT=3210

# Idle unloading (off until `nsf resources idle --set ...`; deploy/install.sh --idle). The console, the worker and
# Pocket may not start a model service themselves: with this set they leave a request in the folder and
# neuroscifi-wake.path has it reloaded. Leave it unset when one account runs everything (`nsf start`).
#NSF_WAKE_DIR=/var/lib/neuroscifi-wake

# The model services' ports are checked before anything is sent to them: a process of another account holding one
# gets nothing. Set to 0 only if you run such a service under another account on purpose.
#NSF_LISTENER_CHECK=0
