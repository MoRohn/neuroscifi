# NeuroSciFi local model server (vLLM, OpenAI-compatible). Defaults for deploy/vllm/run.sh and
# neuroscifi-vllm.service. Override any line in ~/.config/neuroscifi/inference/vllm.env (not in git).
# Measured on DGX Spark GB10 (docs/architecture/COGNITIVE_INFERENCE.md §4).

# Pinned by digest (`docker image inspect vllm/vllm-openai:nightly`): nightly-4fab5a07475822c6eaa971dceb2e2220d0446808,
# vLLM 0.33.0rc1.dev910+g4fab5a074, CUDA 13.0.2, arm64, built 2026-11-06.
NSF_VLLM_IMAGE=vllm/vllm-openai@sha256:48c0a41e8268faf50317ab83dc12c54fe6549b1131b38d06abe5ed15e3009700
NSF_VLLM_CONTAINER=neuroscifi-vllm
# Loopback only. 8000/9000/3000 are used by unrelated containers on the reference host.
NSF_VLLM_BIND=127.0.0.1
NSF_VLLM_PORT=8811
# Weights on the host, mounted read-only. Qwen3-30B-A3B-Instruct-2507-FP8 (Apache-2.0), ~31 GB.
NSF_VLLM_MODEL_DIR=${HOME}/.local/share/neuroscifi/models/qwen3-30b-a3b-instruct-2507-fp8
NSF_VLLM_SERVED_NAME=qwen3-30b-a3b-instruct-2507-fp8
# Unified memory is shared with the CPU and a later speech model: vLLM takes this fraction of it.
NSF_VLLM_GPU_UTIL=0.45
# KV cache size in bytes, fixed. Measured: on GB10 vLLM's utilisation accounting is unreliable when the weights are
# already in the page cache (a warm restart counted 8.35 GiB of weights and gave the KV cache 46 GiB, so the process
# held 76 GiB instead of 55). A fixed KV cache bounds it: 13 GiB = ~142k tokens (4 x 32k contexts).
NSF_VLLM_KV_CACHE_BYTES=13958643712
NSF_VLLM_MAX_LEN=32768
NSF_VLLM_MAX_SEQS=8
# Tool calling for Qwen3 (hermes-style <tool_call> tags).
NSF_VLLM_TOOL_PARSER=hermes
# Container resource ceilings (CPU side; model memory is bounded by NSF_VLLM_GPU_UTIL).
NSF_VLLM_CPUS=12
NSF_VLLM_MEMORY=96g
NSF_VLLM_SHM=8g
NSF_VLLM_PIDS=4096
# Extra vLLM arguments, space separated (e.g. --enforce-eager). Empty by default.
NSF_VLLM_EXTRA_ARGS=
# Where the generated API key and the compile cache live (outside git).
NSF_INFERENCE_DIR=${HOME}/.config/neuroscifi/inference
NSF_VLLM_CACHE_DIR=${HOME}/.cache/neuroscifi/vllm
