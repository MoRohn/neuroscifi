# NeuroSciFi memory models: a text-embedding model and a reranker for semantic memory retrieval
# (docs/web-cortex/MEMORY_INTEGRATION.md §semantic retrieval). Defaults for deploy/memory/run.sh. Override any line
# in ~/.config/neuroscifi/memory/memory.env (not in git). Both are optional: without them memory retrieval is the
# lexical ranking of 0.7.0, unchanged.

# How the two models are served (run.sh). Both ways use the image below, the same ports, key and endpoints:
#   single  one process for both models (deploy/memory/server.py: the image's python, torch and transformers and
#           the standard library's HTTP server). One container, NSF_MEMORY_CONTAINER, on both ports.
#   vllm    two vLLM servers (pooling runner), one container each.
# Measured on the reference host (docs/quality/evidence/open_items_memory_server.json): the same retrieval
# results, about half the memory. To go back: NSF_MEMORY_SERVER=vllm, then `run.sh restart`.
NSF_MEMORY_SERVER=single
NSF_MEMORY_CONTAINER=neuroscifi-memory
# The memory containers' own docker network (created at the first start): a bridge on which containers cannot
# reach each other, so no other container reaches them; ports stay published on loopback. Empty: the default
# bridge, as before.
NSF_MEMORY_NETWORK=neuroscifi-memory
# The same digest-pinned vLLM image as the answer model (deploy/vllm/vllm.env). No further image is pulled or built.
NSF_MEMORY_IMAGE=vllm/vllm-openai@sha256:48c0a41e8268faf50317ab83dc12c54fe6549b1131b38d06abe5ed15e3009700
# Loopback only.
NSF_MEMORY_BIND=127.0.0.1
NSF_MEMORY_EMBED_PORT=18441
NSF_MEMORY_RERANK_PORT=18442
NSF_MEMORY_EMBED_CONTAINER=neuroscifi-memory-embed
NSF_MEMORY_RERANK_CONTAINER=neuroscifi-memory-rerank
# Weights on the host, mounted read-only; the Hugging Face revision is in each directory's REVISION file.
# Qwen/Qwen3-Embedding-0.6B (Apache-2.0) rev 97b0c614…; Qwen/Qwen3-Reranker-0.6B (Apache-2.0) rev e61197ed….
# Another model that speaks /v1/embeddings or /v1/rerank (NVIDIA's embedding NIM, llama-nemotron-embed) needs no
# code change: point `nsf web memory config` at its endpoint instead of starting these.
NSF_MEMORY_EMBED_MODEL_DIR=${HOME}/.local/share/neuroscifi/models/qwen3-embedding-0.6b
NSF_MEMORY_EMBED_SERVED_NAME=qwen3-embedding-0.6b
NSF_MEMORY_RERANK_MODEL_DIR=${HOME}/.local/share/neuroscifi/models/qwen3-reranker-0.6b
NSF_MEMORY_RERANK_SERVED_NAME=qwen3-reranker-0.6b
# Unified memory (as for speech, deploy/voice/voice.env): a small fraction, a fixed small KV cache so vLLM's memory
# profiler is skipped, eager mode (no CUDA-graph capture for a 0.6B model). Memory statements are short.
NSF_MEMORY_GPU_UTIL=0.04
NSF_MEMORY_KV_CACHE_BYTES=268435456
NSF_MEMORY_MAX_LEN=2048
NSF_MEMORY_MAX_SEQS=16
# Container ceilings. CUDA allocations count against the memory cgroup on unified memory.
NSF_MEMORY_CPUS=4
NSF_MEMORY_MEMORY=12g
NSF_MEMORY_PIDS=1024
# The single server's own ceilings (one process, both models).
NSF_MEMORY_SINGLE_MEMORY=8g
NSF_MEMORY_SINGLE_PIDS=256
# Generated API key (shared by both services) and caches, outside git.
NSF_MEMORY_DIR=${NSF_MEMORY_DIR:-${HOME}/.config/neuroscifi/memory}
NSF_MEMORY_CACHE_DIR=${HOME}/.cache/neuroscifi/memory
