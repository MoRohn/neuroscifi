# NeuroSciFi operator console (available from 0.5.0). Loopback only: reach it through an SSH tunnel
# (docs/operations/RUNBOOK.md). Installed disabled.
[Unit]
Description=NeuroSciFi operator console (loopback only)
# Refuse to start unless the (encrypted) state volume is mounted, so data never lands on the unencrypted root disk.
RequiresMountsFor=%S/neuroscifi
After=local-fs.target
# Optional, off by default: refuse to start unless the state directory is itself a mount point. RequiresMountsFor
# above only waits for a mount unit if one exists; if the encrypted volume is not mounted, the state directory
# would be created on the unencrypted root disk. Uncomment after mounting the volume at /var/lib/neuroscifi
# (adjust the path if %S differs). Do not enable it on a host that keeps state on the root filesystem.
#ConditionPathIsMountPoint=/var/lib/neuroscifi

[Service]
Type=simple
User=neuroscifi
Group=neuroscifi

Environment=NSF_DB=%S/neuroscifi/instance.sqlite
Environment=NSF_CONSOLE_PORT=8766
EnvironmentFile=-/etc/neuroscifi/neuroscifi.env

# The console writes its access URL (with the session token) to a 0600 file in the runtime directory. That
# directory is tmpfs and is emptied at every stop, so the service restarts cleanly and a token never survives
# on disk. Read it with: sudo cat /run/neuroscifi/console-url
ExecStart=/opt/neuroscifi/venv/bin/nsf console --db ${NSF_DB} --port ${NSF_CONSOLE_PORT} --url-file %t/neuroscifi/console-url
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

StateDirectory=neuroscifi
StateDirectoryMode=0700
RuntimeDirectory=neuroscifi
RuntimeDirectoryMode=0700
ReadWritePaths=%S/neuroscifi
UMask=0077

# Resource ceilings so a runaway request cannot starve the rest of the host.
MemoryMax=2G
TasksMax=128

# Nothing outside this host may reach or be reached by the console. So the console never runs research itself
# (no --web-worker here): queued tasks run in neuroscifi-webcortex.service, which has network access.
IPAddressDeny=any
IPAddressAllow=localhost

NoNewPrivileges=yes
RemoveIPC=yes
PrivateUsers=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
