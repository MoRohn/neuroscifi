# NeuroSciFi Voice Cortex speech synthesis (Kokoro-82M, loopback 127.0.0.1:18432).
# Docker container from deploy/voice (image built by `deploy/voice/run.sh build` FROM the digest-pinned vLLM image),
# published on loopback only, read-only weights, read-only root filesystem, no capabilities, generated API key
# outside git (~/.config/neuroscifi/voice/api_key, 0600). Optional: voice is off unless the owner uses it, and text
# keeps working without it. Not installed by deploy/install.sh. Install by hand:
#   deploy/voice/run.sh build
#   sudo install -m 0644 deploy/systemd/neuroscifi-voice-tts.service /etc/systemd/system/
#   sudo systemctl edit neuroscifi-voice-tts.service   # set User= and NSF_REPO= for this host
#   sudo systemctl daemon-reload && sudo systemctl enable --now neuroscifi-voice-tts.service
# Health: `deploy/voice/run.sh status`; a real round trip: `nsf voice health` (docs/voice/COGNITIVE_VOICE_BRIDGE.md).
[Unit]
Description=NeuroSciFi Voice Cortex speech synthesis (Kokoro-82M, loopback 127.0.0.1:18432)
After=docker.service network-online.target
Requires=docker.service
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
User=rohn
Environment=NSF_REPO=/home/rohn/neuroscifi
ExecStart=/usr/bin/env bash ${NSF_REPO}/deploy/voice/run.sh foreground tts
ExecStop=/usr/bin/env bash ${NSF_REPO}/deploy/voice/run.sh stop tts
TimeoutStartSec=5min
TimeoutStopSec=60
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target
