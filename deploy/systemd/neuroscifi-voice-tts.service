# NeuroSciFi Voice Cortex speech synthesis (Kokoro-82M, loopback 127.0.0.1:18432).
# Docker container from deploy/voice (image built by `deploy/voice/run.sh build` FROM the digest-pinned vLLM image),
# published on loopback only, read-only weights, read-only root filesystem, no capabilities, generated API key
# outside git (~/.config/neuroscifi/voice/api_key, 0600). Optional: voice is off unless the owner uses it, and text
# keeps working without it. Not installed by deploy/install.sh. Install by hand:
#   deploy/voice/run.sh build
#   sed -e "s#@NSF_USER@#$USER#" -e "s#@NSF_REPO@#$PWD#" deploy/systemd/neuroscifi-voice-tts.service \
#     | sudo install -m 0644 /dev/stdin /etc/systemd/system/neuroscifi-voice-tts.service
#   (the template's @NSF_USER@ / @NSF_REPO@ placeholders fail safe: the unit does not start until they are set)
#   sudo systemctl daemon-reload && sudo systemctl enable --now neuroscifi-voice-tts.service
# Health: `deploy/voice/run.sh status`; a real round trip: `nsf voice health` (docs/voice/COGNITIVE_VOICE_BRIDGE.md).
[Unit]
Description=NeuroSciFi Voice Cortex speech synthesis (Kokoro-82M, loopback 127.0.0.1:18432)
After=docker.service network-online.target
Requires=docker.service
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
User=@NSF_USER@
Environment=NSF_REPO=@NSF_REPO@
ExecStart=/usr/bin/env bash ${NSF_REPO}/deploy/voice/run.sh foreground tts
ExecStop=/usr/bin/env bash ${NSF_REPO}/deploy/voice/run.sh stop tts
TimeoutStartSec=5min
TimeoutStopSec=60
Restart=on-failure
RestartSec=20

# Sandbox of this wrapper process only (the container has its own hardening, above). It runs the docker CLI, which
# talks to the daemon over /run/docker.sock, plus bash, curl to 127.0.0.1 and python3 for the key. Verified with
# scripts/hardened_run.py (docs/operations/HARDENING_VERIFICATION.md). Not applied: ProtectSystem=strict and
# ProtectHome (the wrapper reads and writes its key and cache under the service user's home, whose path the template
# does not know), PrivateUsers (it must keep the docker group to reach the socket).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
