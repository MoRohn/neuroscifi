# NeuroSciFi local model server (ADR-036 draft; docs/architecture/COGNITIVE_INFERENCE.md). vLLM in Docker, bound to
# 127.0.0.1:8811 only, pinned image digest, read-only model mount, generated API key outside git.
# Installed (disabled) by `deploy/install.sh --llm --llm-user USER`, which sets User= and NSF_REPO=; or by hand:
#   sed -e "s#@NSF_USER@#$USER#" -e "s#@NSF_REPO@#$PWD#" deploy/systemd/neuroscifi-vllm.service \
#     | sudo install -m 0644 /dev/stdin /etc/systemd/system/neuroscifi-vllm.service
#   (the template's @NSF_USER@ / @NSF_REPO@ placeholders fail safe: the unit does not start until they are set)
#   sudo systemctl daemon-reload && sudo systemctl enable --now neuroscifi-vllm.service
# The user must be in the docker group; the key and weights live under that user's home (run.sh, vllm.env).
# The research worker reads the key through `nsf llm config --key-file` (ProtectHome=yes there: copy the key to
# /etc/neuroscifi/inference.key, owner root:neuroscifi, mode 0640).
[Unit]
Description=NeuroSciFi local model server (vLLM, loopback)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=@NSF_USER@
Environment=NSF_REPO=@NSF_REPO@
ExecStart=/usr/bin/env bash ${NSF_REPO}/deploy/vllm/run.sh foreground
ExecStop=/usr/bin/env bash ${NSF_REPO}/deploy/vllm/run.sh stop
# Model load and CUDA graph capture take minutes on first start (measured: COGNITIVE_INFERENCE.md §4).
TimeoutStartSec=30min
TimeoutStopSec=60
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=1h
StartLimitBurst=5

# Sandbox of this wrapper process only (the container has its own hardening, above). It runs the docker CLI, which
# talks to the daemon over /run/docker.sock, plus bash, curl to 127.0.0.1 and python3 for the key. Verified with
# scripts/hardened_run.py (docs/operations/HARDENING_VERIFICATION.md). Not applied: ProtectSystem=strict and
# ProtectHome (the wrapper reads and writes its key and cache under the service user's home, whose path the template
# does not know), PrivateUsers (it must keep the docker group to reach the socket).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
