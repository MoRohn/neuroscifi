# NeuroSciFi wake requests (docs/architecture/RESOURCE_SCHEDULING.md §3c): reload a model service the idle policy
# unloaded, on behalf of a process that may not start services itself. The console and the worker run as an
# unprivileged, sandboxed user without Docker access; with NSF_WAKE_DIR set in their environment they leave an empty
# file `<service>.wake` in that folder when a memory lookup finds its service unloaded, or when a connection to a
# model service is refused. They need nothing else: not the idle policy's files (this account's, which they may be
# unable to read), only the right to create a file in the request folder.
# neuroscifi-wake.path sees the request and starts this unit, which runs `nsf resources wake`: each request is
# removed, checked against the policy's own service names (nothing else is ever run), and the service is reloaded
# if this account's own state says the idle policy unloaded it and a reload is due, with the same free-memory check,
# wait and event as any reload. An entry that is not a plain file is removed or moved aside.
# Whoever may write the folder decides how often a request appears, so the command decides how often it starts:
# `--linger 25` keeps it for 25 s, serving within a second what arrives meanwhile. That is 24 starts in ten minutes
# at most, under StartLimitBurst below, whatever is written (before, 30 requests in ten minutes, from a member of
# the group or from three services asking for six models, stopped the unit until `systemctl reset-failed`).
# The limit itself stays as the last stop against a command that fails at once (a wrong NSF_DB, a missing nsf).
# It runs as the docker user that owns the services, like neuroscifi-idle.service, and needs what that unit needs:
# NSF_DB, read-write access to `<NSF_DB>.resources/`, and ownership of the request folder (mode 3770, group: the
# console's; deploy/install.sh --idle creates it and arranges the rest, see RESOURCE_SCHEDULING.md §3d).
# Installed (disabled) by `deploy/install.sh --idle [--idle-user USER]`, which fills the placeholders. Then:
#   systemctl edit neuroscifi-wake.service      # [Service] Environment=NSF_DB=<the instance database>
#   add NSF_WAKE_DIR=<the request folder> to /etc/neuroscifi/neuroscifi.env (console, worker, Pocket)
#   sudo systemctl enable --now neuroscifi-wake.path
# (the template's placeholders fail safe: the units do not start until they are set)
[Unit]
Description=NeuroSciFi wake requests: reload an idle-unloaded model service
After=docker.service
StartLimitIntervalSec=10min
StartLimitBurst=30

[Service]
Type=oneshot
User=@NSF_USER@
Environment=NSF_REPO=@NSF_REPO@
ExecStart=/usr/bin/env bash -c 'exec "${NSF_REPO}/.venv/bin/nsf" resources wake --db "${NSF_DB}" --dir "@NSF_WAKE_DIR@" --linger 25'
# A reload waits for the service to answer (the answer model: minutes on a first start).
TimeoutStartSec=30min

# Sandbox: the same as neuroscifi-idle.service (it runs the same commands: nsf, the docker CLI, deploy/*/run.sh,
# systemctl, /metrics on 127.0.0.1).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
