# NeuroSciFi wake requests (docs/architecture/RESOURCE_SCHEDULING.md §3c): reload a model service the idle policy
# unloaded, on behalf of a process that may not start services itself. The console and the worker run as an
# unprivileged, sandboxed user without Docker access; with NSF_WAKE_DIR set in their environment they leave an empty
# file `<service>.wake` in that folder when a call or a memory lookup finds its service unloaded.
# neuroscifi-wake.path sees it and starts this unit, which runs `nsf resources wake`: each request is removed,
# checked against the policy's own service names (nothing else is ever run) and reloaded with the same free-memory
# check, wait and event as any reload. It runs as the docker user that owns the services, like neuroscifi-idle.service,
# and needs what that unit needs: NSF_DB, and read-write access to `<NSF_DB>.resources/` and to the request folder.
# Not installed by deploy/install.sh. Install by hand, next to the idle timer:
#   sed -e "s#@NSF_USER@#$USER#" -e "s#@NSF_REPO@#$PWD#" -e "s#@NSF_WAKE_DIR@#/path/to/wake#" \
#     deploy/systemd/neuroscifi-wake.service | sudo install -m 0644 /dev/stdin /etc/systemd/system/neuroscifi-wake.service
#   sed -e "s#@NSF_WAKE_DIR@#/path/to/wake#" deploy/systemd/neuroscifi-wake.path \
#     | sudo install -m 0644 /dev/stdin /etc/systemd/system/neuroscifi-wake.path
#   systemctl edit neuroscifi-wake.service      # [Service] Environment=NSF_DB=<the instance database>
#   add NSF_WAKE_DIR=/path/to/wake to the environment of the console and the worker (/etc/neuroscifi/neuroscifi.env)
#   sudo systemctl daemon-reload && sudo systemctl enable --now neuroscifi-wake.path
# (the template's placeholders fail safe: the units do not start until they are set)
[Unit]
Description=NeuroSciFi wake requests: reload an idle-unloaded model service
After=docker.service
StartLimitIntervalSec=10min
StartLimitBurst=30

[Service]
Type=oneshot
User=@NSF_USER@
Environment=NSF_REPO=@NSF_REPO@
ExecStart=/usr/bin/env bash -c 'exec "${NSF_REPO}/.venv/bin/nsf" resources wake --db "${NSF_DB}" --dir "@NSF_WAKE_DIR@"'
# A reload waits for the service to answer (the answer model: minutes on a first start).
TimeoutStartSec=30min

# Sandbox: the same as neuroscifi-idle.service (it runs the same commands: nsf, the docker CLI, deploy/*/run.sh,
# systemctl, /metrics on 127.0.0.1).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
