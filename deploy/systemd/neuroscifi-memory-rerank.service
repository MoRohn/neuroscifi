# NeuroSciFi memory search: the reranker (Qwen3-Reranker-0.6B via vLLM's pooling runner, loopback 127.0.0.1:18442).
# Docker container from deploy/memory (the digest-pinned vLLM image of the answer model), published on loopback
# only, read-only weights, read-only root filesystem, no capabilities, generated API key outside git
# (~/.config/neuroscifi/memory/api_key, 0600). Optional: without it memory is ranked by the embedding model alone
# (nothing is cut), and without both by its words (docs/web-cortex/MEMORY_INTEGRATION.md §5.1). Installed (disabled)
# by `deploy/install.sh --memory --memory-user USER`, which sets User= and NSF_REPO=; or by hand:
#   sed -e "s#@NSF_USER@#$USER#" -e "s#@NSF_REPO@#$PWD#" deploy/systemd/neuroscifi-memory-rerank.service \
#     | sudo install -m 0644 /dev/stdin /etc/systemd/system/neuroscifi-memory-rerank.service
#   (the template's @NSF_USER@ / @NSF_REPO@ placeholders fail safe: the unit does not start until they are set)
#   sudo systemctl daemon-reload && sudo systemctl enable --now neuroscifi-memory-rerank.service
# The user must be in the docker group; the key and weights live under that user's home (run.sh, memory.env).
# Health: `deploy/memory/run.sh status`; what the individual sees: `nsf web memory status`. Then `nsf setup` (or
# `nsf web memory config`, see run.sh) tells the individual where it is. Released while idle only when the owner
# sets a timeout: `nsf resources idle --set rerank=15m` (the idle pass stops and starts this unit through systemctl).
[Unit]
Description=NeuroSciFi memory search: reranker (Qwen3-Reranker-0.6B via vLLM, loopback 127.0.0.1:18442)
After=docker.service network-online.target
Requires=docker.service
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
User=@NSF_USER@
Environment=NSF_REPO=@NSF_REPO@
ExecStart=/usr/bin/env bash ${NSF_REPO}/deploy/memory/run.sh foreground rerank
ExecStop=/usr/bin/env bash ${NSF_REPO}/deploy/memory/run.sh stop rerank
# Measured on the reference host: 58 to 64 s on a first start, 18 to 31 s after (RESOURCE_SCHEDULING.md §4).
TimeoutStartSec=10min
TimeoutStopSec=60
Restart=on-failure
RestartSec=20

# Sandbox of this wrapper process only (the container has its own hardening, above). It runs the docker CLI, which
# talks to the daemon over /run/docker.sock, plus bash, curl to 127.0.0.1 and python3 for the key. The same sandbox
# as neuroscifi-voice-asr.service (verified with scripts/hardened_run.py, docs/operations/HARDENING_VERIFICATION.md).
# Not applied: ProtectSystem=strict and ProtectHome (the wrapper reads and writes its key and cache under the
# service user's home, whose path the template does not know), PrivateUsers (it must keep the docker group to reach
# the socket).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
