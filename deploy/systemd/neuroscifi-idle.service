# NeuroSciFi idle-unload pass (RD-46; docs/architecture/RESOURCE_SCHEDULING.md §3c): `nsf resources tick` unloads a
# local model service (vLLM, speech recognition, speech synthesis, SearXNG) only when the owner set its idle timeout
# (`nsf resources idle --set vllm=30m ...`; all off by default), nothing is in flight, no voice session is open, no
# research task runs and nothing used it within the timeout. With every timeout off it does nothing and exits 0.
# It stops and starts the services with deploy/vllm/run.sh and deploy/voice/run.sh (or systemctl for an active unit),
# so it runs as the docker user that owns them. Not installed by deploy/install.sh. Install by hand:
#   sed -e "s#@NSF_USER@#$USER#" -e "s#@NSF_REPO@#$PWD#" deploy/systemd/neuroscifi-idle.service \
#     | sudo install -m 0644 /dev/stdin /etc/systemd/system/neuroscifi-idle.service
#   sudo install -m 0644 deploy/systemd/neuroscifi-idle.timer /etc/systemd/system/
#   systemctl edit neuroscifi-idle.service      # [Service] Environment=NSF_DB=<the instance database>
#   sudo systemctl daemon-reload && sudo systemctl enable --now neuroscifi-idle.timer
# (the template's @NSF_USER@ / @NSF_REPO@ placeholders fail safe: the unit does not start until they are set)
[Unit]
Description=NeuroSciFi idle-unload pass (opt-in per service)
After=docker.service

[Service]
Type=oneshot
User=@NSF_USER@
Environment=NSF_REPO=@NSF_REPO@
ExecStart=/usr/bin/env bash -c 'exec "${NSF_REPO}/.venv/bin/nsf" resources tick --db "${NSF_DB}"'
# A pass that unloads waits for the stop command (run.sh stop allows 30 s); it never waits for a load.
TimeoutStartSec=5min
Nice=10

# Sandbox of this pass (the same wrapper sandbox as neuroscifi-vllm.service): it runs nsf, the docker CLI over
# /run/docker.sock, deploy/*/run.sh, systemctl (D-Bus over AF_UNIX) and reads /metrics on 127.0.0.1. Not applied:
# ProtectSystem=strict and ProtectHome (it writes the instance database and the run.sh caches under the service
# user's home, whose path the template does not know), PrivateUsers (it must keep the docker group).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
