# NeuroSciFi wake requests: starts neuroscifi-wake.service whenever a request file exists (see that unit's header for
# what a request is and how both are installed). systemd watches the folder itself, so no process polls it.
#
# PathExistsGlob= is checked when this unit starts and again each time the service ends (systemd.path(5)), so a
# request left while the service was running, or before boot, is still served; PathChanged= would miss both. The
# price of that is one start of the service per request that finds it stopped, and a loop if an entry matching the
# pattern can never be removed. The service handles both itself: it stays 25 s each time it starts and serves what
# arrives meanwhile (so the starts are bounded by the clock, not by whoever writes the folder), and it removes or
# renames anything that is not a plain file. The trigger limit is left at systemd's default (200 starts in 2 s):
# reaching it stops the watch until someone restarts it, so it is a last stop against a fault, nothing else.
[Unit]
Description=NeuroSciFi wake requests (watch)

[Path]
PathExistsGlob=@NSF_WAKE_DIR@/*.wake
Unit=neuroscifi-wake.service

[Install]
WantedBy=multi-user.target
