# NeuroSciFi Voice Cortex speech recognition (Whisper large-v3-turbo via vLLM, loopback 127.0.0.1:18431).
# Docker container from deploy/voice (image built by `deploy/voice/run.sh build` FROM the digest-pinned vLLM image),
# published on loopback only, read-only weights, read-only root filesystem, no capabilities, generated API key
# outside git (~/.config/neuroscifi/voice/api_key, 0600). Optional: voice is off unless the owner uses it, and text
# keeps working without it. Not installed by deploy/install.sh. Install by hand:
#   deploy/voice/run.sh build
#   sed -e "s#@NSF_USER@#$USER#" -e "s#@NSF_REPO@#$PWD#" deploy/systemd/neuroscifi-voice-asr.service \
#     | sudo install -m 0644 /dev/stdin /etc/systemd/system/neuroscifi-voice-asr.service
#   (the template's @NSF_USER@ / @NSF_REPO@ placeholders fail safe: the unit does not start until they are set)
#   sudo systemctl daemon-reload && sudo systemctl enable --now neuroscifi-voice-asr.service
# Health: `deploy/voice/run.sh status`; a real round trip: `nsf voice health` (docs/voice/COGNITIVE_VOICE_BRIDGE.md).
[Unit]
Description=NeuroSciFi Voice Cortex speech recognition (Whisper large-v3-turbo via vLLM, loopback 127.0.0.1:18431)
After=docker.service network-online.target
Requires=docker.service
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
User=@NSF_USER@
Environment=NSF_REPO=@NSF_REPO@
ExecStart=/usr/bin/env bash ${NSF_REPO}/deploy/voice/run.sh foreground asr
ExecStop=/usr/bin/env bash ${NSF_REPO}/deploy/voice/run.sh stop asr
TimeoutStartSec=10min
TimeoutStopSec=60
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target
