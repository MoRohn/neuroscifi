{
  "name": "NeuroSciFi Pocket",
  "short_name": "Pocket",
  "description": "Phone interface to one NeuroSciFi instance. Sensors stay off until you start them.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F6F4F3",
  "theme_color": "#F6F4F3",
  "icons": [
    {"src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"},
    {"src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any"}
  ],
  "share_target": {"action": "/", "method": "GET", "params": {"title": "share_title", "text": "share_text", "url": "share_url"}},
  "shortcuts": [
    {"name": "Ask / field session", "short_name": "Field", "url": "/#workspace", "icons": [{"src": "/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Mark an activity", "short_name": "Mark", "url": "/#mark", "icons": [{"src": "/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Sense", "short_name": "Sense", "url": "/#sensor", "icons": [{"src": "/icon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ]
}
